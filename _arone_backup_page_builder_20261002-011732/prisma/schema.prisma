generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CUSTOMER
  ADMIN
  STAFF
}

enum OrderStatus {
  PENDING
  CONFIRMED
  SHIPPED
  DELIVERED
  CANCELLED
}

enum PaymentMethod {
  CASH_ON_DELIVERY
}

model User {
  id                String                 @id @default(cuid())
  name              String
  email             String                 @unique
  phone             String?
  passwordHash      String
  role              Role                   @default(CUSTOMER)
  staffRole         String                 @default("Viewer")
  staffActive       Boolean                @default(true)
  canViewProducts   Boolean                @default(false)
  canCreateProducts Boolean                @default(false)
  canEditProducts   Boolean                @default(false)
  canDeleteProducts Boolean                @default(false)
  createdAt         DateTime               @default(now())
  sessions          Session[]
  orders            Order[]
  stockAdjustments  StockAdjustment[]
  courierEvents     CourierShipmentEvent[]
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model Category {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  description String    @default("")
  products    Product[]
  createdAt   DateTime  @default(now())
}

model Product {
  id               String            @id @default(cuid())
  name             String
  slug             String            @unique
  description      String            @default("")
  imageUrl         String            @default("/products/default.svg")
  price            Int
  compareAtPrice   Int?
  stock            Int               @default(0)
  active           Boolean           @default(true)
  featured         Boolean           @default(false)
  categoryId       String
  category         Category          @relation(fields: [categoryId], references: [id])
  orderItems       OrderItem[]
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  stockAdjustments StockAdjustment[]
  unitCostProfile  ProductUnitCost?

  @@index([categoryId, active])
  @@index([createdAt])
}

model Order {
  id            String            @id @default(cuid())
  orderNo       String            @unique
  userId        String?
  user          User?             @relation(fields: [userId], references: [id], onDelete: SetNull)
  customerName  String
  email         String?
  phone         String
  address       String
  city          String
  area          String            @default("")
  note          String            @default("")
  subtotal      Int
  shippingFee   Int
  total         Int
  status        OrderStatus       @default(PENDING)
  paymentMethod PaymentMethod     @default(CASH_ON_DELIVERY)
  items         OrderItem[]
  shipment      CourierShipment?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  costRecord    FinanceOrderCost?

  @@index([createdAt])
  @@index([status])
  @@index([phone, orderNo])
}

model OrderItem {
  id        String   @id @default(cuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String?
  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  name      String
  unitPrice Int
  quantity  Int
  lineTotal Int
}

// A single row (id=1) stores public tracking IDs, never access tokens or raw scripts.
model AdsTrackingSettings {
  id                  Int      @id @default(1)
  googleEnabled       Boolean  @default(false)
  googleAdsId         String   @default("")
  googlePurchaseLabel String   @default("")
  ga4MeasurementId    String   @default("")
  metaEnabled         Boolean  @default(false)
  metaPixelId         String   @default("")
  updatedAt           DateTime @updatedAt
}

model StockAdjustment {
  id          String   @id @default(cuid())
  productId   String
  product     Product  @relation(fields: [productId], references: [id], onDelete: Restrict)
  adminId     String
  admin       User     @relation(fields: [adminId], references: [id], onDelete: Restrict)
  beforeStock Int
  afterStock  Int
  delta       Int
  reason      String
  createdAt   DateTime @default(now())

  @@index([createdAt])
  @@index([productId, createdAt])
}

// Admin-managed shipment information. One shipment per order in Phase 2.
// No external courier service is contacted and COD collection is manually attested.
enum CourierShipmentStatus {
  DRAFT
  BOOKED
  IN_TRANSIT
  OUT_FOR_DELIVERY
  DELIVERED
  FAILED
  RETURNED
  CANCELLED
}

model CourierShipment {
  id            String                 @id @default(cuid())
  orderId       String                 @unique
  order         Order                  @relation(fields: [orderId], references: [id], onDelete: Restrict)
  courierName   String
  consignmentId String                 @default("")
  trackingUrl   String                 @default("")
  status        CourierShipmentStatus  @default(DRAFT)
  codExpected   Int
  codCollected  Int                    @default(0)
  version       Int                    @default(0)
  events        CourierShipmentEvent[]
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt

  @@index([status, updatedAt])
}

model CourierShipmentEvent {
  id              String                 @id @default(cuid())
  shipmentId      String
  shipment        CourierShipment        @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  adminId         String
  admin           User                   @relation(fields: [adminId], references: [id], onDelete: Restrict)
  fromStatus      CourierShipmentStatus?
  toStatus        CourierShipmentStatus
  beforeCollected Int
  afterCollected  Int
  fromCourierName String                 @default("")
  toCourierName   String                 @default("")
  fromConsignment String                 @default("")
  toConsignment   String                 @default("")
  note            String
  createdAt       DateTime               @default(now())

  @@index([shipmentId, createdAt])
  @@index([createdAt])
}

// Finance management: optional reference unit costs, order-level cost snapshots, and shared expenses.
// All amounts are integer BDT. No values are backfilled for old orders automatically.
model ProductUnitCost {
  id          String   @id @default(cuid())
  productId   String   @unique
  product     Product  @relation(fields: [productId], references: [id], onDelete: Restrict)
  unitCost    Int
  changedById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model FinanceOrderCost {
  id            String                     @id @default(cuid())
  orderId       String                     @unique
  order         Order                      @relation(fields: [orderId], references: [id], onDelete: Restrict)
  productCost   Int
  packagingCost Int                        @default(0)
  courierCost   Int                        @default(0)
  adsCost       Int                        @default(0)
  otherCost     Int                        @default(0)
  recordedById  String
  version       Int                        @default(1)
  revisions     FinanceOrderCostRevision[]
  createdAt     DateTime                   @default(now())
  updatedAt     DateTime                   @updatedAt
}

model FinanceOrderCostRevision {
  id          String           @id @default(cuid())
  orderCostId String
  orderCost   FinanceOrderCost @relation(fields: [orderCostId], references: [id], onDelete: Restrict)
  adminId     String
  before      Json?
  after       Json
  reason      String
  createdAt   DateTime         @default(now())

  @@index([orderCostId, createdAt])
}

// Shared expenses only. Do not enter amounts already allocated to an order as direct costs.
model FinanceExpense {
  id          String    @id @default(cuid())
  category    String
  amount      Int
  description String
  incurredOn  DateTime
  enteredById String
  voidedAt    DateTime?
  voidedById  String?
  voidReason  String?
  createdAt   DateTime  @default(now())

  @@index([incurredOn, voidedAt])
  @@index([createdAt])
}

model SiteSetting {
  id                Int    @id @default(1)
  primaryColor      String @default("#235b37")
  primaryDarkColor  String @default("#173f29")
  primaryLightColor String @default("#edf4e8")

  logoUrl String @default("")

  updatedAt DateTime @default(now()) @updatedAt
}
