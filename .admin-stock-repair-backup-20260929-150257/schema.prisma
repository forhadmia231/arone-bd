generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}

enum Role {
  CUSTOMER
  ADMIN
}
enum OrderStatus {
  PENDING
  CONFIRMED
  SHIPPED
  DELIVERED
  CANCELLED
}
enum PaymentMethod {
  CASH_ON_DELIVERY
}
model User {
  id String @id @default(cuid())
  name String
  email String @unique
  phone String?
  passwordHash String
  role Role @default(CUSTOMER)
  createdAt DateTime @default(now())
  sessions Session[]
  orders Order[]
}
model Session {
  id String @id @default(cuid())
  tokenHash String @unique
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
  @@index([userId])
  @@index([expiresAt])
}
model Category {
  id String @id @default(cuid())
  name String
  slug String @unique
  description String @default("")
  products Product[]
  createdAt DateTime @default(now())
}
model Product {
  id String @id @default(cuid())
  name String
  slug String @unique
  description String @default("")
  imageUrl String @default("/products/default.svg")
  price Int
  compareAtPrice Int?
  stock Int @default(0)
  active Boolean @default(true)
  featured Boolean @default(false)
  categoryId String
  category Category @relation(fields: [categoryId], references: [id])
  orderItems OrderItem[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([categoryId, active])
  @@index([createdAt])
}
model Order {
  id String @id @default(cuid())
  orderNo String @unique
  userId String?
  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)
  customerName String
  email String?
  phone String
  address String
  city String
  area String @default("")
  note String @default("")
  subtotal Int
  shippingFee Int
  total Int
  status OrderStatus @default(PENDING)
  paymentMethod PaymentMethod @default(CASH_ON_DELIVERY)
  items OrderItem[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([createdAt])
  @@index([status])
  @@index([phone, orderNo])
}
model OrderItem {
  id String @id @default(cuid())
  orderId String
  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String?
  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  name String
  unitPrice Int
  quantity Int
  lineTotal Int
}

// A single row (id=1) stores public tracking IDs, never access tokens or raw scripts.
model AdsTrackingSettings {
  id                     Int      @id @default(1)
  googleEnabled          Boolean  @default(false)
  googleAdsId            String   @default("")
  googlePurchaseLabel    String   @default("")
  ga4MeasurementId       String   @default("")
  metaEnabled            Boolean  @default(false)
  metaPixelId            String   @default("")
  updatedAt              DateTime @updatedAt
}
