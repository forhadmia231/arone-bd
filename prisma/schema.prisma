generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CUSTOMER
  ADMIN
  STAFF
}

enum OrderStatus {
  PENDING
  CONFIRMED
  SHIPPED
  DELIVERED
  CANCELLED
}

enum PaymentMethod {
  CASH_ON_DELIVERY
}

model User {
  id                String                 @id @default(cuid())
  name              String
  email             String                 @unique
  phone             String?
  passwordHash      String
  role              Role                   @default(CUSTOMER)
  staffRole         String                 @default("Viewer")
  staffActive       Boolean                @default(true)
  canViewProducts   Boolean                @default(false)
  canCreateProducts Boolean                @default(false)
  canEditProducts   Boolean                @default(false)
  canDeleteProducts Boolean                @default(false)
  createdAt         DateTime               @default(now())
  sessions          Session[]
  orders            Order[]
  stockAdjustments  StockAdjustment[]
  courierEvents     CourierShipmentEvent[]
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model Category {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  description String    @default("")
  products    Product[]
  createdAt   DateTime  @default(now())
}

model Product {
  id               String            @id @default(cuid())
  name             String
  slug             String            @unique
  description      String            @default("")
  imageUrl         String            @default("/products/default.svg")
  price            Int
  compareAtPrice   Int?
  stock            Int               @default(0)
  active           Boolean           @default(true)
  featured         Boolean           @default(false)
  categoryId       String
  category         Category          @relation(fields: [categoryId], references: [id])
  orderItems       OrderItem[]
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  stockAdjustments StockAdjustment[]
  unitCostProfile  ProductUnitCost?

  @@index([categoryId, active])
  @@index([createdAt])
}

model Order {
  id                   String            @id @default(cuid())
  orderNo              String            @unique
  userId               String?
  user                 User?             @relation(fields: [userId], references: [id], onDelete: SetNull)
  customerName         String
  email                String?
  phone                String
  address              String
  city                 String
  area                 String            @default("")
  note                 String            @default("")
  subtotal             Int
  shippingFee          Int
  total                Int
  status               OrderStatus       @default(PENDING)
  paymentMethod        PaymentMethod     @default(CASH_ON_DELIVERY)
  items                OrderItem[]
  shipment             CourierShipment?
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt
  costRecord           FinanceOrderCost?
  couponCode           String            @default("")
  discountAmount       Int               @default(0)
  bundleOfferId        String            @default("")
  bundleOfferTitle     String            @default("")
  bundleDiscountAmount Int               @default(0)

  @@index([createdAt])
  @@index([status])
  @@index([phone, orderNo])
}

model OrderItem {
  id        String   @id @default(cuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String?
  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  name      String
  unitPrice Int
  quantity  Int
  lineTotal Int
}

// A single row (id=1) stores public tracking IDs, never access tokens or raw scripts.
model AdsTrackingSettings {
  id                  Int      @id @default(1)
  googleEnabled       Boolean  @default(false)
  googleAdsId         String   @default("")
  googlePurchaseLabel String   @default("")
  ga4MeasurementId    String   @default("")
  metaEnabled         Boolean  @default(false)
  metaPixelId         String   @default("")
  updatedAt           DateTime @updatedAt
}

model StockAdjustment {
  id          String   @id @default(cuid())
  productId   String
  product     Product  @relation(fields: [productId], references: [id], onDelete: Restrict)
  adminId     String
  admin       User     @relation(fields: [adminId], references: [id], onDelete: Restrict)
  beforeStock Int
  afterStock  Int
  delta       Int
  reason      String
  createdAt   DateTime @default(now())

  @@index([createdAt])
  @@index([productId, createdAt])
}

// Admin-managed shipment information. One shipment per order in Phase 2.
// No external courier service is contacted and COD collection is manually attested.
enum CourierShipmentStatus {
  DRAFT
  BOOKED
  IN_TRANSIT
  OUT_FOR_DELIVERY
  DELIVERED
  FAILED
  RETURNED
  CANCELLED
}

model CourierShipment {
  id            String                 @id @default(cuid())
  orderId       String                 @unique
  order         Order                  @relation(fields: [orderId], references: [id], onDelete: Restrict)
  courierName   String
  consignmentId String                 @default("")
  trackingUrl   String                 @default("")
  status        CourierShipmentStatus  @default(DRAFT)
  codExpected   Int
  codCollected  Int                    @default(0)
  version       Int                    @default(0)
  events        CourierShipmentEvent[]
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt

  @@index([status, updatedAt])
}

model CourierShipmentEvent {
  id              String                 @id @default(cuid())
  shipmentId      String
  shipment        CourierShipment        @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  adminId         String
  admin           User                   @relation(fields: [adminId], references: [id], onDelete: Restrict)
  fromStatus      CourierShipmentStatus?
  toStatus        CourierShipmentStatus
  beforeCollected Int
  afterCollected  Int
  fromCourierName String                 @default("")
  toCourierName   String                 @default("")
  fromConsignment String                 @default("")
  toConsignment   String                 @default("")
  note            String
  createdAt       DateTime               @default(now())

  @@index([shipmentId, createdAt])
  @@index([createdAt])
}

// Finance management: optional reference unit costs, order-level cost snapshots, and shared expenses.
// All amounts are integer BDT. No values are backfilled for old orders automatically.
model ProductUnitCost {
  id          String   @id @default(cuid())
  productId   String   @unique
  product     Product  @relation(fields: [productId], references: [id], onDelete: Restrict)
  unitCost    Int
  changedById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model FinanceOrderCost {
  id            String                     @id @default(cuid())
  orderId       String                     @unique
  order         Order                      @relation(fields: [orderId], references: [id], onDelete: Restrict)
  productCost   Int
  packagingCost Int                        @default(0)
  courierCost   Int                        @default(0)
  adsCost       Int                        @default(0)
  otherCost     Int                        @default(0)
  recordedById  String
  version       Int                        @default(1)
  revisions     FinanceOrderCostRevision[]
  createdAt     DateTime                   @default(now())
  updatedAt     DateTime                   @updatedAt
}

model FinanceOrderCostRevision {
  id          String           @id @default(cuid())
  orderCostId String
  orderCost   FinanceOrderCost @relation(fields: [orderCostId], references: [id], onDelete: Restrict)
  adminId     String
  before      Json?
  after       Json
  reason      String
  createdAt   DateTime         @default(now())

  @@index([orderCostId, createdAt])
}

// Shared expenses only. Do not enter amounts already allocated to an order as direct costs.
model FinanceExpense {
  id          String    @id @default(cuid())
  category    String
  amount      Int
  description String
  incurredOn  DateTime
  enteredById String
  voidedAt    DateTime?
  voidedById  String?
  voidReason  String?
  createdAt   DateTime  @default(now())

  @@index([incurredOn, voidedAt])
  @@index([createdAt])
}

model SiteSetting {
  id                Int    @id @default(1)
  primaryColor      String @default("#235b37")
  primaryDarkColor  String @default("#173f29")
  primaryLightColor String @default("#edf4e8")

  logoUrl String @default("")

  updatedAt DateTime @default(now()) @updatedAt
}

model Page {
  id             String    @id @default(cuid())
  title          String
  slug           String    @unique
  pageType       String    @default("PAGE")
  status         String    @default("DRAFT")
  seoTitle       String    @default("")
  seoDescription String    @default("")
  featuredImage  String    @default("")
  showHeader     Boolean   @default(true)
  showFooter     Boolean   @default(true)
  fullWidth      Boolean   @default(false)
  content        Json      @default("[]")
  publishedAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([status, updatedAt])
  @@index([pageType, status])
}

model PageMedia {
  id        String   @id @default(cuid())
  name      String
  url       String
  alt       String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([updatedAt])
}

model ReusableSection {
  id        String   @id @default(cuid())
  name      String
  block     Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([updatedAt])
}

model PageLead {
  id          String   @id @default(cuid())
  pageId      String   @default("")
  pageTitle   String   @default("")
  pageSlug    String   @default("")
  formName    String   @default("Lead Form")
  name        String   @default("")
  phone       String   @default("")
  email       String   @default("")
  message     String   @default("")
  data        Json     @default("{}")
  source      String   @default("direct")
  medium      String   @default("")
  campaign    String   @default("")
  referrer    String   @default("")
  landingPath String   @default("")
  status      String   @default("NEW")
  createdAt   DateTime @default(now())

  @@index([status, createdAt])
  @@index([pageId, createdAt])
}

model PageMarketingSettings {
  id               String    @id @default(cuid())
  pageId           String    @unique
  analyticsEnabled Boolean   @default(true)
  metaEvent        String    @default("Lead")
  ga4Event         String    @default("generate_lead")
  stickyEnabled    Boolean   @default(false)
  stickyType       String    @default("LINK")
  stickyLabel      String    @default("Order Now")
  stickyUrl        String    @default("/shop")
  stickyPhone      String    @default("")
  stickyMessage    String    @default("")
  publishAt        DateTime?
  unpublishAt      DateTime?
  thankYouUrl      String    @default("")
  ogTitle          String    @default("")
  ogDescription    String    @default("")
  ogImage          String    @default("")
  canonicalUrl     String    @default("")
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([publishAt])
  @@index([unpublishAt])
}

model PageEvent {
  id        String   @id @default(cuid())
  pageId    String
  pageSlug  String   @default("")
  eventType String
  label     String   @default("")
  href      String   @default("")
  source    String   @default("direct")
  medium    String   @default("")
  campaign  String   @default("")
  content   String   @default("")
  term      String   @default("")
  referrer  String   @default("")
  path      String   @default("")
  createdAt DateTime @default(now())

  @@index([pageId, eventType, createdAt])
  @@index([source, createdAt])
  @@index([campaign, createdAt])
}

model PageRevision {
  id             String    @id @default(cuid())
  pageId         String
  title          String
  slug           String
  pageType       String
  status         String
  seoTitle       String    @default("")
  seoDescription String    @default("")
  featuredImage  String    @default("")
  showHeader     Boolean   @default(true)
  showFooter     Boolean   @default(true)
  fullWidth      Boolean   @default(false)
  content        Json
  publishedAt    DateTime?
  note           String    @default("")
  createdById    String    @default("")
  createdAt      DateTime  @default(now())

  @@index([pageId, createdAt])
}

model NavigationItem {
  id        String   @id @default(cuid())
  location  String   @default("HEADER")
  labelEn   String   @default("")
  labelBn   String   @default("")
  href      String   @default("/")
  pageId    String   @default("")
  linkType  String   @default("CUSTOM")
  active    Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([location, active, sortOrder])
}

model PromotionCampaign {
  id                 String    @id @default(cuid())
  name               String
  type               String    @default("BANNER")
  title              String    @default("")
  message            String    @default("")
  imageUrl           String    @default("")
  buttonText         String    @default("")
  buttonUrl          String    @default("")
  couponCode         String    @default("")
  active             Boolean   @default(true)
  dismissible        Boolean   @default(true)
  showOncePerSession Boolean   @default(false)
  startAt            DateTime?
  endAt              DateTime?
  backgroundColor    String    @default("#173F29")
  textColor          String    @default("#FFFFFF")
  targetPath         String    @default("*")
  position           String    @default("BOTTOM")
  priority           Int       @default(0)
  viewCount          Int       @default(0)
  clickCount         Int       @default(0)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([active, priority])
  @@index([startAt, endAt])
}

model CustomerReview {
  id           String   @id @default(cuid())
  customerName String
  rating       Int      @default(5)
  title        String   @default("")
  reviewText   String
  imageUrl     String   @default("")
  source       String   @default("Website")
  productId    String   @default("")
  productName  String   @default("")
  status       String   @default("PENDING")
  featured     Boolean  @default(false)
  verified     Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([status, featured, createdAt])
  @@index([productId])
}

enum CouponDiscountType {
  PERCENTAGE
  FIXED
}

enum CouponScope {
  ALL_PRODUCTS
  SELECTED_PRODUCTS
  SELECTED_CATEGORIES
}

model Coupon {
  id                String             @id @default(cuid())
  code              String             @unique
  name              String
  description       String             @default("")
  active            Boolean            @default(true)
  discountType      CouponDiscountType @default(PERCENTAGE)
  discountValue     Int
  minOrderAmount    Int                @default(0)
  maxDiscountAmount Int?
  scope             CouponScope        @default(ALL_PRODUCTS)
  productIds        Json               @default("[]")
  categoryIds       Json               @default("[]")
  startsAt          DateTime?
  expiresAt         DateTime?
  usageLimit        Int?
  perCustomerLimit  Int                @default(1)
  usedCount         Int                @default(0)
  landingPageOnly   Boolean            @default(false)
  pageIds           Json               @default("[]")
  autoApply         Boolean            @default(false)
  usages            CouponUsage[]
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  @@index([active, startsAt, expiresAt])
  @@index([autoApply, active])
  @@index([createdAt])
}

model CouponUsage {
  id             String   @id @default(cuid())
  couponId       String
  coupon         Coupon   @relation(fields: [couponId], references: [id], onDelete: Cascade)
  orderId        String
  phone          String   @default("")
  discountAmount Int
  orderAmount    Int
  source         String   @default("")
  createdAt      DateTime @default(now())

  @@index([couponId, createdAt])
  @@index([phone, couponId])
  @@index([orderId])
}

enum BundlePricingType {
  FIXED_PRICE
  PERCENTAGE
  FIXED_DISCOUNT
}

model BundleOffer {
  id               String            @id @default(cuid())
  title            String
  slug             String            @unique
  description      String            @default("")
  badge            String            @default("COMBO OFFER")
  imageUrl         String            @default("")
  active           Boolean           @default(true)
  pricingType      BundlePricingType @default(FIXED_PRICE)
  bundlePrice      Int?
  discountValue    Int               @default(0)
  items            Json              @default("[]")
  insideDhakaFee   Int               @default(70)
  outsideDhakaFee  Int               @default(130)
  allowCoupon      Boolean           @default(true)
  startsAt         DateTime?
  expiresAt        DateTime?
  usageLimit       Int?
  perCustomerLimit Int               @default(5)
  usedCount        Int               @default(0)
  usages           BundleUsage[]
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@index([active, startsAt, expiresAt])
  @@index([createdAt])
}

model BundleUsage {
  id             String      @id @default(cuid())
  bundleId       String
  bundle         BundleOffer @relation(fields: [bundleId], references: [id], onDelete: Cascade)
  orderId        String
  phone          String      @default("")
  quantity       Int         @default(1)
  regularAmount  Int
  bundleAmount   Int
  discountAmount Int
  createdAt      DateTime    @default(now())

  @@index([bundleId, createdAt])
  @@index([phone, bundleId])
  @@index([orderId])
}

model AbandonedCheckout {
  id          String    @id @default(cuid())
  sessionKey  String    @unique
  name        String    @default("")
  phone       String    @default("")
  email       String    @default("")
  address     String    @default("")
  city        String    @default("")
  area        String    @default("")
  note        String    @default("")
  source      String    @default("")
  utmSource   String    @default("")
  utmMedium   String    @default("")
  utmCampaign String    @default("")
  pageUrl     String    @default("")
  status      String    @default("ACTIVE")
  payload     Json?
  firstSeenAt DateTime  @default(now())
  lastSeenAt  DateTime  @default(now()) @updatedAt
  contactedAt DateTime?
  recoveredAt DateTime?
  dismissedAt DateTime?
  createdAt   DateTime  @default(now())

  @@index([status, lastSeenAt])
  @@index([phone, lastSeenAt])
}

model CustomerNotificationTemplate {
  id        String   @id @default(cuid())
  key       String   @unique
  name      String
  channel   String   @default("WHATSAPP")
  message   String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CustomerNotification {
  id           String    @id @default(cuid())
  orderId      String?
  orderNo      String    @default("")
  recipient    String
  customerName String    @default("")
  channel      String    @default("WHATSAPP")
  templateKey  String    @default("")
  eventKey     String    @default("")
  message      String
  status       String    @default("QUEUED")
  error        String    @default("")
  sentAt       DateTime?
  createdAt    DateTime  @default(now())

  @@index([status, createdAt])
  @@index([orderNo, createdAt])
  @@index([recipient, createdAt])
}
